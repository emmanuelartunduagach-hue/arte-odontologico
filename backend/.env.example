# Copiar como .env y completar. NUNCA subir .env a Git.

PORT=3000
# Origen del frontend cuando corre aparte (Live Server). Publicado, Express
# sirve el frontend en el mismo dominio y esto no se usa.
ORIGEN_PERMITIDO=http://localhost:5500
# El backend también entrega el frontend (carpeta ../frontend). false = solo API.
SERVIR_FRONTEND=true

# 127.0.0.1 y no "localhost": en Windows, Node puede intentar por IPv6 (::1) y MySQL no responder ahí.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=arte_odontologico

# Clave para firmar los tokens. Generar una aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=8h

# Dirección pública del frontend: se usa en los enlaces de los
# mensajes ("Gestionar mi cita"). En producción, el dominio real.
URL_PUBLICA=http://localhost:5500

# Al publicar detrás de un proxy (Render, Railway, Nginx), poner 1
# para que el límite de peticiones vea la IP real del visitante.
PROXY_CONFIABLE=

# --- Reglas de citas ---
# Horas antes de la cita hasta las que el paciente puede reprogramar o cancelar.
HORAS_MINIMAS_GESTION=24
# Citas pedidas o confirmadas que una persona puede tener a la vez (0 = sin límite).
LIMITE_CITAS_ACTIVAS_POR_DOCUMENTO=1
# Peticiones por IP cada 15 minutos a las rutas públicas de citas.
LIMITE_ESCRITURAS_POR_IP=15
LIMITE_LECTURAS_POR_IP=60
# Intentos de ingreso por IP cada 15 minutos.
LIMITE_INGRESOS_POR_IP=10

# --- Recordatorio 24 horas antes ---
# El servidor revisa cada 30 minutos y genera el recordatorio de las
# citas confirmadas que empiezan en las próximas 24 horas, solo entre
# estas horas (hora de Colombia).
RECORDATORIOS_AUTOMATICOS=true
RECORDATORIO_DESDE=8
RECORDATORIO_HASTA=19
# No recordar citas aceptadas hace menos de estas horas (ya tienen su confirmación).
RECORDATORIO_HORAS_MINIMAS=12

# --- WhatsApp ---
# manual  = la secretaria envía cada mensaje con un clic desde el panel (sin trámites)
# consola = el mensaje se imprime en la terminal (desarrollo y demostraciones)
# twilio  = envío automático con Twilio (pruebas con el WhatsApp Sandbox)
# api     = envío automático con la API de WhatsApp Cloud de Meta
WHATSAPP_MODO=manual

# Solo para WHATSAPP_MODO=twilio (console.twilio.com):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número del sandbox, por ejemplo +14155238886
TWILIO_WHATSAPP_DESDE=

# Solo para WHATSAPP_MODO=api (datos de developers.facebook.com):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_IDIOMA=es
# Nombre de cada plantilla aprobada en Meta. Parámetros en orden:
# {{1}} nombre, {{2}} fecha, {{3}} hora, {{4}} especialista, {{5}} dirección, {{6}} enlace
WHATSAPP_PLANTILLA_CONFIRMACION=
WHATSAPP_PLANTILLA_REPROGRAMACION=
WHATSAPP_PLANTILLA_CANCELACION=
WHATSAPP_PLANTILLA_RECORDATORIO=
WHATSAPP_PLANTILLA_RECHAZO=
# Cuántos de esos parámetros usa cada plantilla (por defecto 6).
WHATSAPP_PARAMETROS_CANCELACION=6
WHATSAPP_PARAMETROS_RECHAZO=6
# El recordatorio no lleva enlace: su plantilla usa los 5 primeros.
WHATSAPP_PARAMETROS_RECORDATORIO=5
