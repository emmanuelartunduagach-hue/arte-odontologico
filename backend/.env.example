# Copiar como .env y completar. NUNCA subir .env a Git.

PORT=3000
ORIGEN_PERMITIDO=http://localhost:5500

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=arte_odontologico

# Clave para firmar los tokens. Generar una aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=8h

# Canal de notificaciones activo: correo | whatsapp | ambos
NOTIFICACIONES_CANAL=correo

# --- Correo (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- WhatsApp (pendiente de aprobación del cambio) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
